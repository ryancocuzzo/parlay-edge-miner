generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AllowlistUser {
  id             String   @id @default(cuid())
  email          String   @unique
  isAdmin        Boolean  @default(false)
  factoryPaused  Boolean  @default(false)
  factoryPerHour Int?
  factoryPerDay  Int?
  createdAt      DateTime @default(now())
}

model FeatureRequest {
  id           String    @id @default(cuid())
  userEmail    String
  kind         String
  category     String?
  title        String
  description  String
  brief        String?
  screenshots  Json      @default("[]")
  status       String
  statusDetail String?
  agentId      String?
  runId        String?
  usage        Json?
  costUsd      Float     @default(0)
  dispatchedAt DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userEmail, createdAt])
  @@index([status])
}

model FactorySettings {
  id                Int     @id @default(1)
  enabled           Boolean @default(true)
  perHour           Int     @default(2)
  perDay            Int     @default(5)
  maxActive         Int     @default(1)
  dailyBudgetUsd    Float   @default(20)
  model             String  @default("claude-sonnet-5-5")
  inputUsdPerM      Float   @default(2)
  outputUsdPerM     Float   @default(10)
  cacheReadUsdPerM  Float   @default(0.1)
  cacheWriteUsdPerM Float   @default(2.5)
}

model SlateSnapshot {
  id        String    @id @default(cuid())
  fetchedAt DateTime
  games     Json
  slate     Json
  settledAt DateTime?
  scores    Json?
  settled   Json?
  createdAt DateTime  @default(now())

  @@index([fetchedAt])
  @@index([settledAt])
}

model CfbTeam {
  id             Int      @id
  school         String
  mascot         String?
  alternateNames String[]
  conference     String?
  classification String?
}

model CfbGame {
  id                 Int        @id
  season             Int
  week               Int
  seasonType         String
  startsAt           DateTime
  completed          Boolean
  neutralSite        Boolean
  venue              String?
  conferenceGame     Boolean
  homeTeam           String
  awayTeam           String
  homeConference     String?
  awayConference     String?
  homeClassification String?
  awayClassification String?
  homePoints         Int?
  awayPoints         Int?
  homeElo            Int?
  awayElo            Int?
  updatedAt          DateTime
  lines              GameLine[]
  picks              StrategyPick[]

  @@index([season, seasonType, week])
  @@index([startsAt])
}

model CfbRanking {
  season     Int
  seasonType String
  week       Int
  poll       String
  school     String
  rank       Int

  @@id([season, seasonType, week, poll, school])
}

model GameLine {
  gameId        Int
  provider      String
  spread        Float?
  spreadOpen    Float?
  total         Float?
  totalOpen     Float?
  homeMoneyline Int?
  awayMoneyline Int?
  game          CfbGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, provider])
}

model ApiCall {
  id        String   @id @default(cuid())
  api       String
  path      String
  status    Int
  remaining Int?
  actor     String?
  createdAt DateTime @default(now())

  @@index([api, createdAt])
}

model Strategy {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  summary       String
  kind          String
  spec          Json?
  specHash      String?
  backtestRunId String?
  meta          Json?
  createdBy     String?
  createdAt     DateTime        @default(now())
  archivedAt    DateTime?
  backtestRun   BacktestRun?    @relation(fields: [backtestRunId], references: [id])
  picks         StrategyPick[]
  boards        StrategyBoard[]
}

model StrategyBoard {
  strategyId  String
  season      Int
  seasonType  String
  week        Int
  generatedAt DateTime
  candidates  Int
  strategy    Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@id([strategyId, season, seasonType, week])
}

model StrategyPick {
  id         String    @id @default(cuid())
  strategyId String
  gameId     Int
  season     Int
  seasonType String
  week       Int
  market     String
  selection  String
  team       String
  price      Int
  line       Float?
  provider   String
  score      Float
  rank       Int
  inputs     Json
  pickedAt   DateTime
  result     String?
  profit     Float?
  gradedAt   DateTime?
  strategy   Strategy  @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  game       CfbGame   @relation(fields: [gameId], references: [id])

  @@unique([strategyId, gameId, market, selection])
  @@index([strategyId, season, seasonType, week])
  @@index([result])
}

model BacktestRun {
  id          String     @id @default(cuid())
  specHash    String
  spec        Json
  dataVersion String
  report      Json
  createdBy   String?
  createdAt   DateTime   @default(now())
  strategies  Strategy[]

  @@index([specHash])
}

model ChatThread {
  id        String   @id @default(cuid())
  userEmail String
  title     String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userEmail, updatedAt])
}
